---
import { getCollection } from 'astro:content';
import SocialLinks from './contact/SocialLinks.astro';
import site from '../data/site.json';

const year = new Date().getFullYear();

/* /decisions exists only once a decision note is published, so the link
   appears on its own rather than pointing at an empty page. */
const hasDecisions = (await getCollection('decisions')).some((d) => d.data.publish);

const columns = [
  {
    label: 'Work',
    links: [
      { href: '/projects', text: 'Projects' },
      { href: '/#services', text: 'Services' },
      { href: '/cv', text: 'CV' },
    ],
  },
  {
    label: 'Content',
    links: [
      { href: '/videos', text: 'Videos' },
      { href: '/blog', text: 'Writing' },
      { href: '/rss.xml', text: 'RSS' },
    ],
  },
  {
    label: 'More',
    links: [
      { href: '/uses', text: 'Uses' },
      ...(hasDecisions ? [{ href: '/decisions', text: 'Decisions' }] : []),
      { href: '/contact', text: 'Contact' },
    ],
  },
];
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_repeat(3,1fr)]">
      <div>
        <a href="/" class="flex items-baseline gap-1.5 font-mono text-sm text-foreground">
          <span class="text-accent">/</span>
          <span class="font-medium">{site.brand}</span>
        </a>
        <p class="mt-3 max-w-xs text-[13px] leading-relaxed text-secondary">
          {site.role}{site.location ? ` · ${site.location}` : ''}
        </p>
        <SocialLinks variant="row" class="mt-4 -ml-2" />
      </div>

      {columns.map((column) => (
        <nav aria-label={column.label}>
          <p class="bp-label">{column.label}</p>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-[13px] text-secondary transition-colors hover:text-accent">
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-line pt-6 sm:flex-row sm:items-center">
      <p class="bp-label">© {year} {site.name}</p>
      <p class="bp-label">Built with Astro · Deployed on push</p>
    </div>
  </div>
</footer>
