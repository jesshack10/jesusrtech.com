---
import type { CollectionEntry } from 'astro:content';
import Tag from '../ui/Tag.astro';
import { formatDate } from '../../utils/formatDate';
import { readingTime } from '../../utils/sortPosts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const time = readingTime(post.body ?? '');
---

<article class="group border-b border-border py-8 last:border-b-0">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-2">
    <a href={`/blog/${post.id}`}>
      <h2 class="text-lg font-semibold text-foreground group-hover:text-accent transition-colors leading-snug">
        {title}
      </h2>
    </a>
    <span class="text-sm text-muted shrink-0">{formatDate(pubDate)}</span>
  </div>

  <p class="text-secondary text-sm leading-relaxed mb-4">{description}</p>

  <div class="flex items-center justify-between">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => <Tag variant="neutral">{tag}</Tag>)}
    </div>
    <span class="text-xs text-muted">{time}</span>
  </div>
</article>
