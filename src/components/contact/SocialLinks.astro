---
import site from '../../data/site.json';

interface Props {
  /** Compact icon row (footer/nav) vs. full cards with blurbs. */
  variant?: 'cards' | 'row';
  class?: string;
}

const { variant = 'cards', class: className } = Astro.props;

const icons: Record<string, string> = {
  github:
    '<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>',
  linkedin:
    '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  youtube:
    '<path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>',
  x:
    '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
  email:
    '<path d="M1.5 5.25A2.25 2.25 0 013.75 3h16.5a2.25 2.25 0 012.25 2.25v13.5A2.25 2.25 0 0120.25 21H3.75a2.25 2.25 0 01-2.25-2.25V5.25zm2.02-.75l8.48 6.36 8.48-6.36H3.52z"/>',
};

/* A link that still says TODO is not a link — hide it rather than ship a
   dead entry to a visitor. */
const isReal = (url: string) => Boolean(url) && !url.trim().toUpperCase().startsWith('TODO');

const socials = site.socials.filter((s) => isReal(s.url));

const entries = [
  ...socials,
  {
    key: 'email',
    name: 'Email',
    url: `mailto:${site.email}`,
    handle: site.email,
    blurb: 'The most reliable way to start a conversation.',
  },
];
---

{variant === 'row' ? (
  <ul class:list={['flex flex-wrap items-center gap-1', className]}>
    {entries.map((s) => (
      <li>
        <a
          href={s.url}
          target={s.key === 'email' ? undefined : '_blank'}
          rel={s.key === 'email' ? undefined : 'noopener noreferrer'}
          class="flex h-9 w-9 items-center justify-center rounded-[3px] text-muted
                 transition-colors hover:bg-elevated hover:text-accent"
          aria-label={s.name}
          title={s.name}
        >
          <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.key]} />
        </a>
      </li>
    ))}
  </ul>
) : (
  <ul class:list={['grid gap-3 sm:grid-cols-2', className]}>
    {entries.map((s, i) => (
      <li
        class="bp-ticks group relative border border-border bg-surface/40 transition-colors
               duration-200 hover:border-accent/40 hover:bg-surface"
        data-reveal
        style={`--reveal-delay: ${i * 60}ms`}
      >
        <a
          href={s.url}
          target={s.key === 'email' ? undefined : '_blank'}
          rel={s.key === 'email' ? undefined : 'noopener noreferrer'}
          class="flex h-full items-start gap-4 p-5"
        >
          <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[3px] border border-border text-secondary transition-colors group-hover:border-accent/40 group-hover:text-accent">
            <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.key]} />
          </span>

          <span class="min-w-0 flex-1">
            <span class="flex items-baseline gap-2">
              <span class="font-medium text-foreground">{s.name}</span>
              <span class="truncate font-mono text-[11px] text-muted">{s.handle}</span>
            </span>
            <span class="mt-1 block text-[13px] leading-relaxed text-secondary">{s.blurb}</span>
          </span>

          <span aria-hidden="true" class="bp-label shrink-0 transition-colors group-hover:text-accent">↗</span>
        </a>
      </li>
    ))}
  </ul>
)}
