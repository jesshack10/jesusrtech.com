---
import Tag from '../ui/Tag.astro';

interface Props {
  category: string;
  items: string[];
}

const { category, items } = Astro.props;
---

<div class="mb-5 last:mb-0">
  <p class="text-xs font-medium text-muted uppercase tracking-wider mb-2">{category}</p>
  <div class="flex flex-wrap gap-1.5">
    {items.map((item) => <Tag variant="neutral">{item}</Tag>)}
  </div>
</div>
