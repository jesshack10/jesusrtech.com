---
import SectionHeading from '../ui/SectionHeading.astro';
import { t, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).faq;
---

<section class="border-t border-line" id="faq">
  <div class="mx-auto max-w-3xl px-6 py-20">
    <SectionHeading index="05" label={copy.label}>
      {copy.title}
    </SectionHeading>

    <div class="divide-y divide-line border-y border-line">
      {copy.items.map((item, i) => (
        <details class="group py-4" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-foreground">
            {item.q}
            <span
              aria-hidden="true"
              class="font-mono text-accent transition-transform duration-150 group-open:rotate-45"
            >+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-secondary text-pretty">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
