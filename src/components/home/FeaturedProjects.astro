---
import { getCollection } from 'astro:content';
import ProjectCard from '../projects/ProjectCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);
---

{featured.length > 0 && (
  <section class="max-w-5xl mx-auto px-6 py-16 border-t border-border">
    <div class="flex items-end justify-between mb-10">
      <SectionHeading label="Work">Featured Projects</SectionHeading>
      <Button href="/projects" variant="ghost" class="hidden sm:inline-flex">All projects →</Button>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="mt-8 sm:hidden">
      <Button href="/projects" variant="secondary">All projects →</Button>
    </div>
  </section>
)}
