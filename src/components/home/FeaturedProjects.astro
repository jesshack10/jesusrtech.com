---
import { getCollection } from 'astro:content';
import ProjectCard from '../projects/ProjectCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

const all = await getCollection('projects');

/* Fall back to the most recent work when nothing is explicitly featured,
   so the section is never empty just because a flag was forgotten. */
const featured = all.filter((p) => p.data.featured);
const pool = featured.length > 0 ? featured : all;

const projects = pool
  .sort((a, b) => {
    const order = (a.data.order ?? 99) - (b.data.order ?? 99);
    return order !== 0 ? order : b.data.pubDate.getTime() - a.data.pubDate.getTime();
  })
  .slice(0, 4);
---

{projects.length > 0 && (
  <section class="border-t border-line" id="work">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <SectionHeading
        index="02"
        label="Work"
        lede="Selected engagements. Each one lists what changed as a result — the numbers matter more than the tech stack."
      >
        Proof, not promises
      </SectionHeading>

      <div class="grid gap-3 sm:grid-cols-2">
        {projects.map((project, i) => (
          <ProjectCard project={project} index={i} />
        ))}
      </div>

      <div class="mt-8">
        <Button href="/projects" variant="secondary" size="sm">
          All projects
          <span aria-hidden="true" class="transition-transform duration-150 group-hover/btn:translate-x-0.5">→</span>
        </Button>
      </div>
    </div>
  </section>
)}
