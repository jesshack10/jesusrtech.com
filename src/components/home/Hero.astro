---
import Button from '../ui/Button.astro';
import AvailabilityBadge from '../ui/AvailabilityBadge.astro';
import site from '../../data/site.json';
import { primaryCta } from '../../utils/cta';
import { t, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).hero;
const cta = primaryCta(lang);

/* The spec panel — metadata as a drawing-sheet title block. */
const spec = copy.spec;

/* The tools a client will recognise, not the whole CV skill list. */
const stack = copy.tools;
---

<section class="relative overflow-hidden border-b border-line">
  <!-- Drafting grid, masked so it dissolves before it reaches the content -->
  <div
    aria-hidden="true"
    class="bp-grid bp-grid-fade pointer-events-none absolute inset-0 opacity-70"
  ></div>

  <div class="relative mx-auto max-w-6xl px-6 pb-20 pt-20 sm:pt-28">
    <div class="grid items-start gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      <!-- ── Pitch ───────────────────────────────────────────── -->
      <div>
        <div data-reveal>
          <AvailabilityBadge lang={lang} />
        </div>

        <p class="bp-label mt-7" data-reveal style="--reveal-delay: 60ms">
          {site.name}
        </p>

        <h1
          class="mt-3 text-4xl font-semibold leading-[1.08] tracking-tight text-foreground sm:text-5xl text-balance"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          {copy.headline}
        </h1>

        <p
          class="mt-5 max-w-xl text-lg leading-relaxed text-secondary text-pretty sm:text-xl"
          data-reveal
          style="--reveal-delay: 160ms"
        >
          {copy.subheadline}
        </p>

        <div
          class="mt-9 flex flex-wrap items-center gap-3"
          data-reveal
          style="--reveal-delay: 240ms"
        >
          <Button href={cta.href} external={cta.external} variant="primary">
            {cta.label}
            <span
              aria-hidden="true"
              class="transition-transform duration-150 group-hover/btn:translate-x-0.5"
            >→</span>
          </Button>
          <Button href="#case" variant="secondary">{copy.secondary}</Button>
        </div>
      </div>

      <!-- ── Title block ─────────────────────────────────────── -->
      <aside
        class="bp-ticks rounded-[3px] border border-border bg-surface/70 backdrop-blur-sm"
        data-reveal
        style="--reveal-delay: 320ms"
      >
        <div class="flex items-center justify-between border-b border-line px-5 py-3">
          <span class="bp-label">{copy.specTitle}</span>
          <span class="bp-label text-accent">v2026.1</span>
        </div>

        <dl class="divide-y divide-line">
          {spec.map(({ key, value }) => (
            <div class="flex items-baseline gap-4 px-5 py-3">
              <dt class="bp-label w-24 shrink-0">{key}</dt>
              <dd class="text-[13px] leading-snug text-foreground">{value}</dd>
            </div>
          ))}
        </dl>

        <div class="border-t border-line px-5 py-4">
          <span class="bp-label">{copy.toolsTitle}</span>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {stack.map((item) => (
              <li class="rounded-[2px] border border-border px-1.5 py-0.5 font-mono text-[11px] leading-none text-secondary">
                {item}
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>
