---
import SectionHeading from '../ui/SectionHeading.astro';
import { t, type Lang } from '../../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).services;
---

<section class="mx-auto max-w-6xl px-6 py-20" id="services">
  <SectionHeading index="01" label={copy.label} lede={copy.lede}>
    {copy.title}
  </SectionHeading>

  <div class="space-y-14">
    {copy.tracks.map((track) => (
      <div>
        <!-- Track header: which kind of client this is for -->
        <div class="mb-6 grid gap-3 border-t border-line pt-6 lg:grid-cols-[1fr_1.4fr] lg:gap-10" data-reveal>
          <h3 class="flex items-baseline gap-3 text-xl font-semibold tracking-tight text-foreground text-balance">
            <span class="bp-label text-accent">{track.code}</span>
            <span>{track.title}</span>
          </h3>
          <p class="text-sm leading-relaxed text-secondary text-pretty">{track.audience}</p>
        </div>

        <div class:list={['grid gap-3', track.offers.length > 2 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
          {track.offers.map((offer, i) => (
            <article
              class="bp-ticks flex flex-col border border-border bg-surface/40 p-6
                     transition-colors duration-200 hover:border-accent/40 hover:bg-surface"
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <div class="mb-4 flex items-center justify-between gap-4">
                <span class="bp-label text-accent">{offer.price}</span>
                <span class="bp-label">{offer.duration}</span>
              </div>

              <h4 class="text-lg font-semibold tracking-tight text-foreground">
                {offer.title}
              </h4>

              <p class="mt-2.5 text-sm leading-relaxed text-secondary text-pretty">
                {offer.summary}
              </p>

              <ul class="mt-5 space-y-2 border-t border-line pt-4">
                {offer.deliverables.map((item) => (
                  <li class="flex gap-2.5 text-[13px] leading-snug text-secondary">
                    <span aria-hidden="true" class="mt-[7px] h-px w-2.5 shrink-0 bg-accent"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
