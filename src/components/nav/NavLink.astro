---
interface Props {
  href: string;
  mobile?: boolean;
}

const { href, mobile = false } = Astro.props;
const isActive = Astro.url.pathname === href || Astro.url.pathname.startsWith(href + '/');
---

<a
  href={href}
  class:list={[
    'transition-colors font-medium text-sm',
    mobile
      ? 'block px-3 py-2 rounded-md'
      : 'px-3 py-1.5 rounded-md',
    isActive
      ? 'text-green bg-green/10'
      : 'text-secondary hover:text-foreground hover:bg-elevated',
  ]}
>
  <slot />
</a>
