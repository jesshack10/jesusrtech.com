---
import { getCollection } from 'astro:content';
import NavLink from './NavLink.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import Button from '../ui/Button.astro';
import site from '../../data/site.json';
import { primaryCta } from '../../utils/cta';
import { t, homePath, type Lang } from '../../utils/i18n';

interface Props {
  lang?: Lang;
  /** The same page in other languages; the first one that isn't this page
      becomes the language switch. Empty on English-only pages. */
  alternates?: { lang: Lang; href: string }[];
}

const { lang = 'en', alternates = [] } = Astro.props;
const copy = t(lang).nav;
const home = homePath(lang);

/* Like /decisions in the footer: the Videos link appears once there is a video. */
const hasVideos = (await getCollection('videos')).length > 0;

const navLinks = [
  { href: `${home}#services`, label: copy.services },
  { href: `${home}#case`,     label: copy.case },
  { href: '/projects',        label: copy.work },
  ...(hasVideos ? [{ href: '/videos', label: copy.videos }] : []),
  { href: '/blog',            label: copy.writing },
  { href: '/cv',              label: copy.cv },
];

const switchTo = alternates.find((alt) => alt.lang !== lang);

const cta = primaryCta(lang);
---

<header class="sticky top-0 z-50 border-b border-line bg-base/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6" aria-label="Main">
    <a
      href={home}
      class="group flex items-baseline gap-1.5 font-mono text-sm tracking-tight text-foreground"
    >
      <span class="text-accent transition-opacity group-hover:opacity-70">/</span>
      <span class="font-medium">{site.brand}</span>
    </a>

    <ul class="hidden items-center md:flex">
      {navLinks.map((link) => (
        <li><NavLink href={link.href}>{link.label}</NavLink></li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      {switchTo && (
        <a
          href={switchTo.href}
          hreflang={switchTo.lang}
          lang={switchTo.lang}
          title={copy.switchTitle}
          class="rounded-[3px] border border-border px-2 py-1 font-mono text-[11px] font-medium tracking-wide
                 text-secondary transition-colors hover:border-accent/40 hover:text-foreground"
        >
          {copy.switchLabel}
        </a>
      )}
      <ThemeToggle />

      <Button href={cta.href} external={cta.external} variant="primary" size="sm" class="hidden sm:inline-flex">
        {cta.label}
      </Button>

      <button
        id="mobile-menu-btn"
        class="rounded-[3px] p-2 text-secondary transition-colors hover:bg-elevated hover:text-foreground md:hidden"
        aria-label={copy.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.75" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-base md:hidden">
    <ul class="mx-auto max-w-6xl px-6 py-3">
      {navLinks.map((link) => (
        <li><NavLink href={link.href} mobile>{link.label}</NavLink></li>
      ))}
    </ul>
    <div class="mx-auto max-w-6xl border-t border-line px-6 py-4 sm:hidden">
      <Button href={cta.href} external={cta.external} variant="primary" class="w-full">
        {cta.label}
      </Button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
  }

  btn?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  // Escape closes the menu and returns focus to the control that opened it.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setOpen(false);
      btn?.focus();
    }
  });
</script>
