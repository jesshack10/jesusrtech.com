---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Index within a grid, used to stagger the reveal. */
  index?: number;
}

const { project, index = 0 } = Astro.props;
const {
  title, description, tags, status, repoUrl, liveUrl,
  role, client, confidential, year, outcome, metrics,
} = project.data;

const statusVariant = {
  active:    'text-[var(--ok)]',
  completed: 'text-secondary',
  archived:  'text-muted',
} as const;

/* Under NDA we show the shape of the work and drop anything identifying. */
const clientLabel = confidential ? 'Confidential client' : client;
const showLinks = !confidential && (repoUrl || liveUrl);
---

<article
  class="bp-ticks group relative flex flex-col border border-border bg-surface/40 p-6
         transition-colors duration-200 hover:border-accent/40 hover:bg-surface"
  data-reveal
  style={`--reveal-delay: ${index * 70}ms`}
>
  <!-- Header strip: the drawing's identifying marks -->
  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1">
    {year && <span class="bp-label">{year}</span>}
    {clientLabel && (
      <>
        <span aria-hidden="true" class="h-3 w-px bg-border"></span>
        <span class="bp-label">{clientLabel}</span>
      </>
    )}
    <span class:list={['bp-label ml-auto', statusVariant[status]]}>{status}</span>
  </div>

  <h3 class="text-lg font-semibold leading-snug tracking-tight text-foreground">
    <a href={`/projects/${project.id}`} class="after:absolute after:inset-0 hover:text-accent transition-colors">
      {title}
    </a>
  </h3>

  {role && <p class="mt-1 text-[13px] text-muted">{role}</p>}

  <p class="mt-3 text-sm leading-relaxed text-secondary text-pretty">
    {outcome || description}
  </p>

  {metrics.length > 0 && (
    <dl class="mt-5 grid gap-4 border-t border-line pt-4" style={`grid-template-columns: repeat(${metrics.length}, minmax(0, 1fr))`}>
      {metrics.map((metric) => (
        <div>
          <dt class="bp-label">{metric.label}</dt>
          <dd class="mt-1.5 font-mono text-xl font-medium tracking-tight text-accent">
            {metric.value}
          </dd>
        </div>
      ))}
    </dl>
  )}

  <div class="mt-auto pt-5">
    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {tags.slice(0, 5).map((tag) => (
          <li class="rounded-[2px] border border-border px-1.5 py-0.5 font-mono text-[11px] leading-none text-muted">
            {tag}
          </li>
        ))}
      </ul>
    )}

    {showLinks && (
      <!-- relative + z-10 keeps these clickable above the card-wide title link -->
      <div class="relative z-10 mt-4 flex gap-4 border-t border-line pt-4">
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bp-label transition-colors hover:text-accent"
          >
            Source ↗
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bp-label transition-colors hover:text-accent"
          >
            Live ↗
          </a>
        )}
      </div>
    )}
  </div>
</article>
