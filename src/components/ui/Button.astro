---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', class: className, ...rest } = Astro.props;

const base = 'inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green';

const variants = {
  primary:   'bg-green text-base hover:opacity-90 active:scale-[0.98]',
  secondary: 'border border-border text-foreground hover:bg-elevated active:scale-[0.98]',
  ghost:     'text-secondary hover:text-foreground hover:bg-elevated',
};
---

{href ? (
  <a href={href} class:list={[base, variants[variant], className]} {...rest}>
    <slot />
  </a>
) : (
  <button class:list={[base, variants[variant], className]} {...rest}>
    <slot />
  </button>
)}
