---
interface Props {
  /** Two-digit section number, e.g. "01". Part of the drawing-sheet feel. */
  index?: string;
  /** Short uppercase category, e.g. "WORK". */
  label?: string;
  /** Supporting sentence under the title. */
  lede?: string;
  id?: string;
  class?: string;
}

const { index, label, lede, id, class: className } = Astro.props;
---

<header class:list={['mb-10', className]} id={id}>
  {(index || label) && (
    <div class="flex items-center gap-3 mb-4" data-reveal>
      {index && <span class="bp-label text-accent">{index}</span>}
      {index && label && <span aria-hidden="true" class="h-px w-6 bg-border"></span>}
      {label && <span class="bp-label">{label}</span>}
      <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
    </div>
  )}

  <h2
    class="text-2xl sm:text-3xl font-semibold text-foreground tracking-tight text-balance"
    data-reveal
    style="--reveal-delay: 60ms"
  >
    <slot />
  </h2>

  {lede && (
    <p
      class="mt-3 text-secondary leading-relaxed max-w-2xl text-pretty"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      {lede}
    </p>
  )}
</header>
