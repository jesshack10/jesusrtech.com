---
interface Props {
  variant?: 'green' | 'blue' | 'yellow' | 'neutral';
}

const { variant = 'neutral' } = Astro.props;

const variants = {
  green:   'bg-green/10 text-green border-green/20',
  blue:    'bg-blue/10 text-blue border-blue/20',
  yellow:  'bg-yellow/10 text-yellow border-yellow/20',
  neutral: 'bg-elevated text-secondary border-border',
};
---

<span class:list={['inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium border', variants[variant]]}>
  <slot />
</span>
