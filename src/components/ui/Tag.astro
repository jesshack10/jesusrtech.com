---
interface Props {
  variant?: 'accent' | 'ok' | 'info' | 'neutral';
  mono?: boolean;
}

const { variant = 'neutral', mono = true } = Astro.props;

const variants = {
  accent:  'border-accent/35 text-accent bg-accent/8',
  ok:      'border-[var(--ok)]/35 text-[var(--ok)] bg-[var(--ok)]/8',
  info:    'border-[var(--info)]/35 text-[var(--info)] bg-[var(--info)]/8',
  neutral: 'border-border text-secondary bg-transparent',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-[2px] border px-1.5 py-0.5 text-[11px] leading-none',
    mono && 'font-mono tracking-wide',
    variants[variant],
  ]}
>
  <slot />
</span>
