---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../utils/i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: Lang;
  alternates?: { lang: Lang; href: string }[];
}

const { title, description, ogImage, lang = 'en', alternates = [] } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} lang={lang} alternates={alternates}>
  <Navbar lang={lang} alternates={alternates} />
  <main id="main" class="min-h-screen">
    <slot />
  </main>
  <Footer />
</BaseLayout>
