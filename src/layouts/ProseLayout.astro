---
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<PageLayout title={title} description={description} ogImage={ogImage}>
  <article class="max-w-2xl mx-auto px-6 py-16">
    <slot />
  </article>
</PageLayout>
