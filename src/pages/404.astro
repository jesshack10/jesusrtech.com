---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
---

<PageLayout title="404 — Page not found" description="This page doesn't exist.">
  <div class="max-w-5xl mx-auto px-6 py-32 text-center">
    <p class="text-6xl font-bold text-border mb-6">404</p>
    <h1 class="text-2xl font-semibold text-foreground mb-4">Page not found</h1>
    <p class="text-secondary mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <Button href="/" variant="primary">Go home</Button>
  </div>
</PageLayout>
