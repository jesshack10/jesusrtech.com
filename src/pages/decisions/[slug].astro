---
import { getCollection, render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  /* Unpublished decisions get no route at all, so a private note cannot be
     reached even by guessing its URL. */
  const decisions = (await getCollection('decisions')).filter((d) => d.data.publish);
  return decisions.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ProseLayout
  title={`${entry.data.title} — Decisions`}
  description={entry.data.summary}
>
  <header class="mb-10 not-prose">
    <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="bp-label">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      </span>
      <span aria-hidden="true" class="h-3 w-px bg-border"></span>
      <span class="bp-label text-accent">{entry.data.status}</span>
    </div>

    <h1 class="mb-4 text-3xl font-semibold leading-tight tracking-tight text-foreground">
      {entry.data.title}
    </h1>

    <p class="border-t border-border pt-4 text-sm leading-relaxed text-secondary">
      {entry.data.summary}
    </p>
  </header>

  <div class="prose prose-neutral max-w-none">
    <Content />
  </div>

  <footer class="mt-16 border-t border-border pt-8 not-prose">
    <a href="/decisions" class="text-sm text-secondary transition-colors hover:text-foreground">
      ← Back to decisions
    </a>
  </footer>
</ProseLayout>
