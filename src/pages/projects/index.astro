---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    return b.data.pubDate.getTime() - a.data.pubDate.getTime();
  });
---

<PageLayout
  title="Projects — jesusrtech"
  description="A selection of projects I've built or contributed to."
>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      index="//"
      label="Work"
      lede="Case studies from client and personal work. Each one leads with what changed as a result."
    >
      Projects
    </SectionHeading>

    {projects.length === 0 ? (
      <p class="border border-dashed border-border p-8 text-center text-sm text-muted">
        No projects yet.
      </p>
    ) : (
      <div class="grid gap-3 sm:grid-cols-2">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    )}
  </div>
</PageLayout>
