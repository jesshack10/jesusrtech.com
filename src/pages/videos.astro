---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import VideoCard from '../components/videos/VideoCard.astro';
import site from '../data/site.json';

const videos = (await getCollection('videos')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const channel = site.socials.find(
  (s) => s.key === 'youtube' && s.url && !s.url.toUpperCase().startsWith('TODO'),
);
---

<PageLayout
  title="Videos — jesusrtech"
  description="Talks, walkthroughs, and build logs."
>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <SectionHeading
      index="//"
      label="Video"
      lede="Talks, walkthroughs, and build logs. Everything here is public — watch before you hire."
    >
      Videos
    </SectionHeading>

    {videos.length > 0 ? (
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {videos.map((video, i) => (
          <VideoCard video={video} index={i} />
        ))}
      </div>
    ) : (
      <p class="border border-dashed border-border p-8 text-center text-sm text-muted">
        No videos yet. Add entries to <code class="font-mono text-accent">src/data/videos.json</code>.
      </p>
    )}

    {channel && (
      <p class="mt-10 text-sm text-secondary">
        More on
        <a
          href={channel.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent underline underline-offset-4 hover:text-[var(--accent-hi)]"
        >
          {channel.name} ↗
        </a>
      </p>
    )}
  </div>
</PageLayout>
